# Copy to .env and adjust. Defaults to MOCK mode so the dashboard runs without a Vault.

# Set to "false" to query a real PVWA. Leave as "true" (or unset) for the demo/mock data.
CYBERARK_MOCK=true

PORT=3000

# --- Live mode only (CYBERARK_MOCK=false) ---
# Base URL of the PVWA, e.g. https://pvwa.intern.example.com
PVWA_BASE_URL=
# CyberArk | LDAP | RADIUS | Windows
CYBERARK_AUTH_METHOD=CyberArk
# Dedicated READ-ONLY monitoring service account (Auditor role is sufficient).
CYBERARK_USERNAME=
CYBERARK_PASSWORD=
